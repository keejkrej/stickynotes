<Page x:Class="StickyNotes.Windows.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="WidgetRoot" Background="#88FFD966" CornerRadius="12" Padding="14" RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="DragRegion" Background="Transparent" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{x:Bind ViewModel.Notes}" SelectedItem="{x:Bind ViewModel.SelectedNote, Mode=TwoWay}" DisplayMemberPath="Title" PlaceholderText="Choose a note" MinWidth="220" HorizontalAlignment="Stretch"/>
            <Button Grid.Column="1" Command="{x:Bind ViewModel.AddNoteCommand}" ToolTipService.ToolTip="New note"><FontIcon Glyph="&#xE710;"/></Button>
            <Button Grid.Column="2" Click="Close_Click" ToolTipService.ToolTip="Close"><FontIcon Glyph="&#xE8BB;"/></Button>
        </Grid>
        <TextBox Grid.Row="1" Header="Title" Text="{x:Bind ViewModel.SelectedNote.Title, Mode=TwoWay}" TextChanged="Editor_TextChanged" IsEnabled="{x:Bind HasSelection, Mode=OneWay}"/>
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <AutoSuggestBox PlaceholderText="Search notes" QueryIcon="Find" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <ComboBox Grid.Column="1" Width="90" ItemsSource="{x:Bind ViewModel.Colors}" SelectedItem="{x:Bind ViewModel.SelectedNote.Color, Mode=TwoWay}" SelectionChanged="Editor_SelectionChanged"/>
            <ToggleButton Grid.Column="2" IsChecked="{x:Bind ViewModel.IsPreview, Mode=TwoWay}" ToolTipService.ToolTip="Markdown preview"><FontIcon Glyph="&#xE890;"/></ToggleButton>
            <Button Grid.Column="3" Command="{x:Bind ViewModel.DeleteNoteCommand}" ToolTipService.ToolTip="Delete"><FontIcon Glyph="&#xE74D;"/></Button>
        </Grid>
        <TextBox x:Name="BodyEditor" Grid.Row="3" Text="{x:Bind ViewModel.SelectedNote.Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="Editor_TextChanged" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="16" VerticalContentAlignment="Top" Visibility="{x:Bind EditorVisibility, Mode=OneWay}" Background="#33FFFFFF" BorderThickness="0"/>
        <ScrollViewer Grid.Row="3" Visibility="{x:Bind PreviewVisibility, Mode=OneWay}" Background="#33FFFFFF" Padding="10"><RichTextBlock x:Name="MarkdownPreview" IsTextSelectionEnabled="True" FontSize="16" Foreground="Black"/></ScrollViewer>
        <TextBlock Grid.Row="4" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Foreground="#99000000" FontSize="11" HorizontalAlignment="Right"/>
    </Grid>
</Page>
