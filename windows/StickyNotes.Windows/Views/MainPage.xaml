<Page x:Class="StickyNotes.Windows.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="WidgetRoot" Background="Transparent" Padding="16,10,16,14" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="20"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
            <Border x:Name="DragRegion" Grid.Column="0" Background="Transparent" Padding="2,0">
                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE70B;" FontSize="16"/>
                    <TextBlock Text="STICKY NOTES" FontSize="12" FontWeight="SemiBold" CharacterSpacing="80" VerticalAlignment="Center"/>
                    <FontIcon Glyph="&#xE76F;" FontSize="12" Opacity="0.45"/>
                </StackPanel>
            </Border>
            <Button Grid.Column="1" Command="{x:Bind ViewModel.AddNoteCommand}" Style="{StaticResource WidgetIconButton}" ToolTipService.ToolTip="New note"><FontIcon Glyph="&#xE710;"/></Button>
            <Button Grid.Column="2" Click="Close_Click" Style="{StaticResource WidgetIconButton}" ToolTipService.ToolTip="Close"><FontIcon Glyph="&#xE8BB;"/></Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{x:Bind ViewModel.Notes}" SelectedItem="{x:Bind ViewModel.SelectedNote, Mode=TwoWay}" DisplayMemberPath="Title" PlaceholderText="Choose a note" HorizontalAlignment="Stretch"/>
            <Button Grid.Column="1" Command="{x:Bind ViewModel.DeleteNoteCommand}" Style="{StaticResource WidgetIconButton}" ToolTipService.ToolTip="Delete note"><FontIcon Glyph="&#xE74D;"/></Button>
        </Grid>

        <TextBox Grid.Row="2" PlaceholderText="Note title" Text="{x:Bind ViewModel.SelectedNote.Title, Mode=TwoWay}" TextChanged="Editor_TextChanged" IsEnabled="{x:Bind HasSelection, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" Padding="2,7"/>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <AutoSuggestBox PlaceholderText="Search notes" QueryIcon="Find" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <ToggleButton Grid.Column="1" IsChecked="{x:Bind ViewModel.IsPreview, Mode=TwoWay}" Style="{StaticResource WidgetIconToggleButton}" ToolTipService.ToolTip="Markdown preview"><FontIcon Glyph="&#xE890;"/></ToggleButton>
        </Grid>

        <Border Grid.Row="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="4">
            <Grid>
                <TextBox x:Name="BodyEditor" Text="{x:Bind ViewModel.SelectedNote.Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="Editor_TextChanged" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Segoe UI Variable Text" FontSize="15" VerticalContentAlignment="Top" Visibility="{x:Bind EditorVisibility, Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="9"/>
                <ScrollViewer Visibility="{x:Bind PreviewVisibility, Mode=OneWay}" Padding="10"><RichTextBlock x:Name="MarkdownPreview" IsTextSelectionEnabled="True" FontSize="15"/></ScrollViewer>
            </Grid>
        </Border>
        <TextBlock Grid.Row="5" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
    </Grid>
</Page>
