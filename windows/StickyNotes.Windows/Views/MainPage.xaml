<Page x:Class="StickyNotes.Windows.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:StickyNotes.Windows.Models">
    <Grid x:Name="WidgetRoot" Background="Transparent" Padding="16,10,16,14" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="20"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border x:Name="DragRegion" Grid.Column="0" Background="Transparent" Padding="2,0">
                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE70B;" FontSize="16"/>
                    <TextBlock Text="STICKY NOTES" FontSize="12" FontWeight="SemiBold" CharacterSpacing="80" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Button Grid.Column="1" Command="{x:Bind ViewModel.AddNoteCommand}" Width="36" Height="36" Padding="0" ToolTipService.ToolTip="New note"><FontIcon Glyph="&#xE710;" FontSize="16"/></Button>
            <Button Grid.Column="2" Click="Close_Click" Width="36" Height="36" Padding="0" ToolTipService.ToolTip="Close"><FontIcon Glyph="&#xE8BB;" FontSize="14"/></Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="NotePicker" PlaceholderText="Find or switch notes" VerticalAlignment="Center"
                ItemsSource="{x:Bind ViewModel.Notes}" TextMemberPath="Title"
                TextChanged="NotePicker_TextChanged" SuggestionChosen="NotePicker_SuggestionChosen" QuerySubmitted="NotePicker_QuerySubmitted">
                <AutoSuggestBox.QueryIcon>
                    <FontIcon Glyph="&#xE721;" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </AutoSuggestBox.QueryIcon>
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Note">
                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
            <ToggleButton Grid.Column="1" IsChecked="{x:Bind ViewModel.IsPreview, Mode=TwoWay}" Width="36" Height="36" Padding="0" ToolTipService.ToolTip="Markdown preview"><FontIcon Glyph="&#xE890;" FontSize="16"/></ToggleButton>
            <Button Grid.Column="2" Command="{x:Bind ViewModel.DeleteNoteCommand}" Width="36" Height="36" Padding="0" ToolTipService.ToolTip="Delete note"><FontIcon Glyph="&#xE74D;" FontSize="16"/></Button>
        </Grid>

        <TextBox x:Name="TitleEditor" Grid.Row="2" PlaceholderText="Note title" Text="{x:Bind ViewModel.SelectedNote.Title, Mode=TwoWay}" TextChanged="Editor_TextChanged" IsEnabled="{x:Bind HasSelection, Mode=OneWay}"/>

        <Grid Grid.Row="3">
            <TextBox x:Name="BodyEditor" Text="{x:Bind ViewModel.SelectedNote.Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="Editor_TextChanged" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Visibility="{x:Bind EditorVisibility, Mode=OneWay}"/>
            <ScrollViewer Visibility="{x:Bind PreviewVisibility, Mode=OneWay}"><RichTextBlock x:Name="MarkdownPreview" IsTextSelectionEnabled="True"/></ScrollViewer>
        </Grid>
        <TextBlock Grid.Row="4" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
    </Grid>
</Page>
